# Browser-visible configuration only. Server secrets (SEPOLIA_RPC_URL, OPERATOR_PRIVATE_KEY,
# SUI_OPERATOR_PRIVATE_KEY, OPENAI_API_KEY, AGENT_COOKIE_SECRET) are read from the repository root `.env`.

# Reown (WalletConnect) project id from https://cloud.reown.com. When unset, the app connects through the
# browser's injected wallet (MetaMask, Rabby, …) only.
NEXT_PUBLIC_REOWN_PROJECT_ID=
