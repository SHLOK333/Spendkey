{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/.well-known/agent-card.json", "destination": "/api/.well-known/agent-card.json" }
  ],
  "crons": [
    { "path": "/api/cron/refresh-prices", "schedule": "0 0 * * *" }
  ]
}
