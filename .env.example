# ─────────────────────────────────────────────────────────────────────────────
# BUCKET environment. Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# EVM network: `sepolia` (live) or `sepolia-fork` (local anvil fork of Sepolia)
EVM_NETWORK=sepolia
# Sepolia RPC (required for `sepolia`, and as the upstream for `anvil --fork-url`)
SEPOLIA_RPC_URL=
# Local fork endpoint (only used when EVM_NETWORK=sepolia-fork)
LOCAL_FORK_RPC_URL=http://127.0.0.1:8545

# Keys (0x-prefixed 32-byte hex). Each account needs Sepolia ETH for gas.
# Deployer: deploys contracts, owns the test tokens (mint) and publishes reference prices.
DEPLOYER_PRIVATE_KEY=
# Bucket owner: registers <ENS_OWNER_LABEL>.eth on ENSv2 and owns every Bucket.
OWNER_PRIVATE_KEY=
# Operator / solver: owns <ENS_OPERATOR_LABEL>.trading.<owner>.eth and executes rebalances.
OPERATOR_PRIVATE_KEY=
# Optional dedicated price reporter (defaults to the deployer).
PRICE_REPORTER_PRIVATE_KEY=
# Optional, for contract verification.
ETHERSCAN_API_KEY=

# ENSv2 names (official Sepolia ENSv2 deployment)
ENS_OWNER_LABEL=shlok
ENS_OPERATOR_LABEL=agent
ENS_REGISTRATION_YEARS=1

# Sui
SUI_NETWORK=testnet
# Optional custom gRPC endpoint (defaults to the public fullnode of SUI_NETWORK)
SUI_GRPC_URL=
# Bucket owner on Sui (bech32 `suiprivkey1…`, ed25519, funded from the testnet faucet)
SUI_PRIVATE_KEY=
# Optional operator on Sui (receives the OperatorCap and records executions)
SUI_OPERATOR_PRIVATE_KEY=
# Sui CLI binary used to compile the Move package (>= 1.60; `sui` on PATH by default, or .tools/sui.exe)
SUI_BIN=

# Reference prices published to BucketReferencePriceFeed (decimal USD)
PRICE_USDC=1
PRICE_ETH=2500
PRICE_SUI=3.5
PRICE_PEPE=0.001

# Demo funding of the trading Bucket (USD)
DEMO_FUNDING_USD=2000
